{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pareto AI",
  "mainBinaryName": "pareto-desktop",
  "version": "0.1.0",
  "identifier": "dev.logicamp.paretoai",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "copyright": "Copyright (c) pareto-ai contributors",
    "shortDescription": "Local AI model router with a spend and quality console",
    "longDescription": "Pareto AI runs the pareto-ai gateway on your machine and opens its console. Prices, budgets and routing stay local; provider credentials are encrypted at rest.",
    "externalBin": ["binaries/pareto-gateway"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "devel"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
